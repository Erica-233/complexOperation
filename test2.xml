<widget class="QWidget" name="MainWindow">
  <layout class="QVBoxLayout">
    <item>
      <widget class="QLineEdit" name="num1Input">
        <property name="placeholderText">
          <string>输入第一个数 (支持负数)</string>
        </property>
      </widget>
    </item>
    <item>
      <widget class="QLineEdit" name="num2Input">
        <property name="placeholderText">
          <string>输入第二个数 (支持负数)</string>
        </property>
      </widget>
    </item>
    <item>
      <widget class="QSpinBox" name="precisionSpin">
        <property name="minimum">
          <number>0</number>
        </property>
        <property name="maximum">
          <number>20</number>
        </property>
        <property name="value">
          <number>4</number>
        </property>
        <property name="prefix">
          <string>小数位数: </string>
        </property>
      </widget>
    </item>
    <item>
      <layout class="QHBoxLayout">
        <item>
          <widget class="QPushButton" name="addBtn">
            <property name="text">
              <string>＋ 加法</string>
            </property>
          </widget>
        </item>
        <item>
          <widget class="QPushButton" name="subBtn">
            <property name="text">
              <string>－ 减法</string>
            </property>
          </widget>
        </item>
        <item>
          <widget class="QPushButton" name="mulBtn">
            <property name="text">
              <string>× 乘法</string>
            </property>
          </widget>
        </item>
        <item>
          <widget class="QPushButton" name="divBtn">
            <property name="text">
              <string>÷ 除法</string>
            </property>
          </widget>
        </item>
      </layout>
    </item>
    <item>
      <widget class="QTextBrowser" name="resultDisplay"/>
    </item>
  </layout>
</widget>
